PORT=3000

# Local MongoDB, or your free MongoDB Atlas connection string for deployment
MONGODB_URI=mongodb://127.0.0.1:27017/resume-builder

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Free Google Gemini key (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Frontend URL(s) allowed to call the API (comma-separated). Leave empty for local development.
CLIENT_URL=
